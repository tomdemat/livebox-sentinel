# Livebox Sentinel configuration. Copy this file to .env and fill it in:
#   cp .env.example .env

# --- Your Livebox (administration access) ---
LIVEBOX_URL=http://192.168.1.1/
LIVEBOX_USERNAME=admin
LIVEBOX_PASSWORD=change-me

# --- Sentinel's own account (first login) ---
# Used only to create the account on first start; change it afterwards in « Mon compte ».
# At least 12 characters: Sentinel refuses to start with the sample value below.
WEB_USERNAME=admin
WEB_PASSWORD=change-me

# --- Web access ---
# Port opened on the server running Sentinel (not the Livebox).
WEB_PORT=8080
# Address you type to open Sentinel: used for the links in e-mail alerts.
PUBLIC_URL=http://192.168.1.10:8080
# Only when running without Docker: interface to listen on.
# WEB_HOST=0.0.0.0

# --- Collection ---
# Seconds between two readings of the Livebox (minimum 10).
COLLECT_INTERVAL=30
DATABASE_PATH=/data/livebox-sentinel.sqlite3

# Behind an HTTPS reverse proxy: its IP address (cookies and origin checks then see https).
# FORWARDED_ALLOW_IPS=127.0.0.1
